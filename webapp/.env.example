GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session signing key — REQUIRED in production. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=

# Comma-separated emails auto-granted admin on login (bootstraps the first admin)
ADMIN_EMAILS=

# Optional. Defaults to sqlite:///./app.db for local dev.
# The Docker/Lightsail deploy points this at the persistent volume:
#   DATABASE_URL=sqlite:////app/data/app.db
#DATABASE_URL=

# Set to true in production (served over HTTPS) so the session cookie is
# marked Secure and only sent over TLS. Keep false/unset for local dev.
SESSION_COOKIE_SECURE=false

# Public domain for the deployment. Used by the Lightsail deploy script to
# configure Caddy + automatic HTTPS. Leave blank for local dev.
DOMAIN=
